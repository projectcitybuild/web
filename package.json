{
    "private": true,
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "typecheck": "vue-tsc --noEmit",
        "generate:contracts": "php artisan scramble:export --api=v3 --path=docs/openapi/v3.json && php artisan typescript:transform && npm run generate:openapi-types",
        "generate:openapi-types": "openapi-typescript docs/openapi/v3.json -o resources/js/generated/openapi.d.ts && node scripts/generate-openapi-enums.mjs",
        "test:openapi-enums": "node --test scripts/generate-openapi-enums.test.mjs",
        "test:deployment": "node --test scripts/verify-deployment.test.mjs"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.3.5",
        "@types/node": "^26.6.6",
        "axios": "^1.21.1",
        "laravel-vite-plugin": "^3.2.1",
        "openapi-typescript": "7.13.0",
        "tailwindcss": "^4.3.5",
        "typescript": "^5.9.3",
        "vite": "^8.3.8",
        "vue-tsc": "^3.3.14"
    },
    "browser": {
        "sifter": false
    },
    "dependencies": {
        "@codemirror/lang-json": "^6.0.2",
        "@inertiajs/vue3": "^3.11.0",
        "@tabler/icons-vue": "^3.52.0",
        "@tailwindcss/forms": "^0.5.11",
        "@vitejs/plugin-vue": "^6.0.11",
        "@vuepic/vue-datepicker": "^14.0.0",
        "@vueuse/core": "^15.0.0",
        "codemirror": "^6.0.2",
        "date-fns": "^4.4.0",
        "flowbite": "^4.0.2",
        "minimessage-js": "^2.1.2",
        "openapi-fetch": "^0.17.0",
        "typescript-result": "^3.5.2",
        "vue": "^3.5.45"
    }
}
