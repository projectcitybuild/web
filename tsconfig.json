{
    "compilerOptions": {
        "module": "ESNext",
        "target": "ESNext",
        "jsx": "preserve",
        "allowJs": true,
        "noImplicitAny": true,
        "removeComments": true,
        "sourceMap": true,
        "moduleResolution": "Bundler",
        "allowSyntheticDefaultImports": true,
        "lib": ["DOM", "ESNext"],
        "strict": true,
        "skipLibCheck": true,
        "types": ["vite/client", "node"]
    },
    "include": [
        "resources/js/**/*.ts",
        "resources/js/**/*.vue",
        "resources/js/**/*.d.ts"
    ],
    "exclude": [
        "node_modules",
        "vendor",
    ],
}
